# CounterAPI (https://counterapi.dev) — powers the visitor counter.
# Sign up (free), create a workspace, then generate an API token.
# Set these in Vercel → Settings → Environment Variables (and locally in .env.local).

COUNTERAPI_TOKEN=your-api-token-here
COUNTERAPI_WORKSPACE=your-workspace-slug
# Optional — counter name (defaults to "portfolio-visitors")
# COUNTERAPI_COUNTER=portfolio-visitors
